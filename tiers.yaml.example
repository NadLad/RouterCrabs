# RouterCrabs — complete multi-provider configuration example
#
# RouterCrabs is provider-agnostic: routing, journaling, feedback and the
# RSI loop all operate on *configured tiers* and the semantic simple/complex
# axis. Nothing here is tied to DeepSeek — swap any model/api_base/key.
#
# Routing phases:
#   Phase 1 — Domain keywords: if keywords match → domain tier
#   Phase 2 — Complexity: otherwise, complexity heuristics → simple or complex
#   Phase 3 — default: true tier (if no fallback section)
#
# Complexity score = objective heuristics + signed keyword weights
# (a signed integer — it can go negative):
#   - Prompt length (>300, >800, >2000 chars)          → +1, +2, +3
#   - Code presence (```, fn, class, SELECT…)            → +2, +3
#   - Images                                              → +5
#   - Technical keywords                                 → +1 each
#   - Simple keywords (salut, hello, merci…)             → -3 each (counterweight)
#   - Question words (pourquoi, why, comment…)           → 0 (neutral markers)
# Score >= threshold → complex model; otherwise → simple model.

port: 8001
host: "127.0.0.1"

# Path to the append-only JSONL journal (default: journal.jsonl).
# Written at chmod 600; every request is logged as one JSON line.
journal_path: "journal.jsonl"

# ── Domain tiers (keywords) ──────────────────────────────────────────
# Phase 1 of routing: keywords match → this tier wins (score × weight).
# Ties are broken by weight, then default: true.
tiers:

  # Groq (Llama) — handles anything about resumes / cover letters.
  # Example: "Rédige une lettre de motivation" → routed to Llama on Groq.
  - model: "llama-3.3-70b-versatile"
    api_base: "https://api.groq.com/openai"
    api_key: "${GROQ_API_KEY}"
    auth_header: "Bearer"                 # default — omit it if unused
    keywords: ["resume", "cv", "cover letter", "motivation letter"]
    weight: 20

  # Local vLLM server — code reviews, refactors, SQL.
  # Example: "refactor ce module rust" → routed to the local vLLM.
  - model: "qwen2.5-coder-32b"
    api_base: "http://127.0.0.1:8000/v1"
    api_key: "${VLLM_API_KEY}"            # vLLM ignores it, but keep the key
    auth_header: "Bearer"
    keywords: ["refactor", "debug", "sql", "rust", "python", "docker"]
    weight: 15

  # Alternative: a provider with non-Bearer auth (e.g. native Anthropic).
  # - model: "claude-sonnet-4"
  #   api_base: "https://api.anthropic.com"
  #   api_key: "${ANTHROPIC_API_KEY}"
  #   auth_header: "x-api-key"            # <-- non-Bearer header
  #   keywords: ["anthropic-specific-domain"]
  #   weight: 10

# ── Complexity routing (fallback) ────────────────────────────────────
# Phase 2: when no domain keyword matches, score the prompt complexity and
# pick simple (fast/cheap) or complex (strong) from the fallback pair.
fallback:
  threshold: 2
  simple:
    model: "deepseek-v4-flash"
    api_base: "https://api.deepseek.com"
    api_key: "${DEEPSEEK_API_KEY}"
  complex:
    model: "deepseek-v4-pro"
    api_base: "https://api.deepseek.com"
    api_key: "${DEEPSEEK_API_KEY}"

# ── Ultimate default (optional) ──────────────────────────────────────
# If you have no `fallback` section, mark exactly one tier `default: true`.
#   - model: "deepseek-v4-flash"
#     api_base: "https://api.deepseek.com"
#     api_key: "${DEEPSEEK_API_KEY}"
#     keywords: []
#     default: true
